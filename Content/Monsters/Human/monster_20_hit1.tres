[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://Scripts/Combat/SkillDefinition.cs" id="skill"]
[ext_resource type="Script" path="res://Scripts/Combat/HitDefinition.cs" id="hit"]
[ext_resource type="Script" path="res://Scripts/Combat/HitEvent.cs" id="window"]

[sub_resource type="Resource" id="hit"]
script = ExtResource("hit")
FlatDamage = 0.0
AttackMultiplier = 3.75
DamageType = 0
Knockback = Vector2(100, -100)

[sub_resource type="Resource" id="window"]
script = ExtResource("window")
StartFrame = 12
EndFrame = 30
Hit = SubResource("hit")

[resource]
script = ExtResource("skill")
Id = "human_20_hit1"
Animation = &"hit1_1"
FramesPerSecond = 60
CooldownSeconds = 1.5
Hits = Array[Resource]([SubResource("window")])
