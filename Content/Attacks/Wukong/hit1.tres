[gd_resource type="Resource" script_class="AttackStep" format=3]

[ext_resource type="Script" path="res://Scripts/Combat/AttackStep.cs" id="step"]
[ext_resource type="Script" path="res://Scripts/Combat/HitDefinition.cs" id="hit"]
[ext_resource type="Script" path="res://Scripts/Combat/ActionMotion.cs" id="motion"]

