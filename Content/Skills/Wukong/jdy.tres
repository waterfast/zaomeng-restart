[gd_resource type="Resource" script_class="SkillDefinition" format=3]

[ext_resource type="AudioStream" path="res://Assets/Audio/Hero/42_Role1_hit11.mp3" id="sound"]

[ext_resource type="PackedScene" path="res://Content/Skills/Behaviors/CloudFlight.tscn" id="behavior"]
[ext_resource type="Script" path="res://Scripts/Combat/SkillDefinition.cs" id="skill"]
[ext_resource type="Script" path="res://Scripts/Combat/HitEvent.cs" id="event"]
[ext_resource type="Script" path="res://Scripts/Combat/HitDefinition.cs" id="hit"]
[ext_resource type="Script" path="res://Scripts/Combat/ActionMotion.cs" id="motion"]

[ext_resource type="Resource" path="res://Content/Skills/Growth/Wukong/jdy.tres" id="growth"]

[ext_resource type="Resource" path="res://Content/Combat/WushuangGains/8_10.tres" id="wushuang_gain"]

[sub_resource type="Resource" id="movement"]
script = ExtResource("motion")
Mode = 2
Speed = 1000.0

[sub_resource type="Resource" id="hit_data"]
script = ExtResource("hit")
AttackMultiplier = 0.54
AttackMultiplierMax = 0.54
MultiplierPerLevel = 0.07
DamageType = 1
Knockback = Vector2(1050, 0)

[sub_resource type="Resource" id="wave_1"]
script = ExtResource("event")
StartFrame = 0
EndFrame = 1
Hit = SubResource("hit_data")

[sub_resource type="Resource" id="wave_2"]
script = ExtResource("event")
StartFrame = 2
EndFrame = 3
Hit = SubResource("hit_data")

[sub_resource type="Resource" id="wave_3"]
script = ExtResource("event")
StartFrame = 4
EndFrame = 5
Hit = SubResource("hit_data")

[sub_resource type="Resource" id="wave_4"]
script = ExtResource("event")
StartFrame = 6
EndFrame = 7
Hit = SubResource("hit_data")

[sub_resource type="Resource" id="wave_5"]
script = ExtResource("event")
StartFrame = 8
EndFrame = 9
Hit = SubResource("hit_data")



[resource]
script = ExtResource("skill")
WushuangGain = ExtResource("wushuang_gain")
Sound = ExtResource("sound")
Growth = ExtResource("growth")
Id = "jdy"
Animation = &"jdy"
FramesPerSecond = 20
CooldownSeconds = 2.4
Motion = SubResource("movement")
Hits = Array[ExtResource("event")]([SubResource("wave_1"), SubResource("wave_2"), SubResource("wave_3"), SubResource("wave_4"), SubResource("wave_5")])
BehaviorScene = ExtResource("behavior")
