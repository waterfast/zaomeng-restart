[gd_resource type="Resource" script_class="SkillDefinition" format=3]

[ext_resource type="Script" path="res://Scripts/Combat/SkillDefinition.cs" id="skill"]
[ext_resource type="Script" path="res://Scripts/Combat/HitEvent.cs" id="event"]
[ext_resource type="Script" path="res://Scripts/Combat/HitDefinition.cs" id="hit"]
[ext_resource type="Script" path="res://Scripts/Combat/ActionMotion.cs" id="motion"]

[sub_resource type="Resource" id="movement"]
script = ExtResource("motion")
Mode = 2
Speed = 1000.0

[sub_resource type="Resource" id="hit_data"]
script = ExtResource("hit")
AttackMultiplier = 0.11
AttackMultiplierMax = 0.11
MultiplierPerLevel = 0.02
Knockback = Vector2(30, 15)

[sub_resource type="Resource" id="hit_window"]
script = ExtResource("event")
StartFrame = 0
EndFrame = 10
Hit = SubResource("hit_data")

[resource]
script = ExtResource("skill")
Id = "qsez"
Animation = &"qsez"
CooldownSeconds = 4.8
BaseManaCost = 10
ManaCostLinearGrowth = 8
ManaCostQuadraticGrowth = 2
Motion = SubResource("movement")
Hits = Array[ExtResource("event")]([SubResource("hit_window")])
