[gd_resource type="Resource" script_class="PassiveSkillDefinition" format=3]

[ext_resource type="Script" path="res://Scripts/Combat/Effects/PassiveSkillDefinition.cs" id="skill"]
[ext_resource type="Script" path="res://Scripts/Combat/Effects/SkillParameterEffect.cs" id="effect"]
[ext_resource type="Resource" path="res://Content/Skills/Wukong/lyfb.tres" id="target"]

[ext_resource type="Script" path="res://Scripts/Combat/Effects/AttackParameterModifiers.cs" id="modifiers"]

[sub_resource type="Resource" id="parameters"]
script = ExtResource("modifiers")
DamageMultiplier = 1.5

[sub_resource type="Resource" id="bonus"]
script = ExtResource("effect")
TargetSkills = Array[Resource]([ExtResource("target")])
AffectsNormalAttacks = false
Modifiers = SubResource("parameters")

[resource]
script = ExtResource("skill")
Id = "earth_fury"
NameKey = "SKILL_EARTH_FURY_NAME"
DescriptionKey = "SKILL_EARTH_FURY_DESCRIPTION"
Effect = SubResource("bonus")
